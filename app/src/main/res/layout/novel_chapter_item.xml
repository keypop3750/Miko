<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Chapter Number -->
    <TextView
        android:id="@+id/chapter_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:minWidth="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Ch. 1" />

    <!-- Chapter Title -->
    <TextView
        android:id="@+id/chapter_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintEnd_toStartOf="@id/read_indicator"
        app:layout_constraintStart_toEndOf="@id/chapter_number"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Chapter Title That Might Be Very Long And Need To Wrap" />

    <!-- Chapter Date -->
    <TextView
        android:id="@+id/chapter_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintStart_toStartOf="@id/chapter_title"
        app:layout_constraintTop_toBottomOf="@id/chapter_title"
        tools:text="Oct 10, 2025" />

    <!-- Word Count -->
    <TextView
        android:id="@+id/chapter_word_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintStart_toEndOf="@id/chapter_date"
        app:layout_constraintTop_toTopOf="@id/chapter_date"
        app:layout_constraintBottom_toBottomOf="@id/chapter_date"
        tools:text="2.5k words" />

    <!-- Reading Time -->
    <TextView
        android:id="@+id/reading_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/chapter_word_count"
        app:layout_constraintTop_toTopOf="@id/chapter_date"
        app:layout_constraintBottom_toBottomOf="@id/chapter_date"
        tools:text="12m read"
        tools:visibility="visible" />

    <!-- Progress Section -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        android:max="100"
        app:layout_constraintEnd_toStartOf="@id/chapter_progress"
        app:layout_constraintStart_toStartOf="@id/chapter_title"
        app:layout_constraintTop_toBottomOf="@id/chapter_date"
        tools:progress="45"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/chapter_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/read_indicator"
        app:layout_constraintTop_toTopOf="@id/progress_bar"
        app:layout_constraintBottom_toBottomOf="@id/progress_bar"
        tools:text="45%"
        tools:visibility="visible" />

    <!-- Status Indicators -->
    <ImageView
        android:id="@+id/read_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_done_24dp"
        android:tint="?attr/colorPrimary"
        android:visibility="gone"
        android:contentDescription="Read"
        app:layout_constraintEnd_toStartOf="@id/bookmark_indicator"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/bookmark_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_bookmark_24dp"
        android:tint="?attr/colorSecondary"
        android:visibility="gone"
        android:contentDescription="Bookmarked"
        app:layout_constraintEnd_toStartOf="@id/download_indicator"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/download_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_download_off_24dp"
        android:tint="?attr/colorTertiary"
        android:visibility="gone"
        android:contentDescription="Downloaded"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>