<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton with shimmer - cover only, no text -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_gravity="center_vertical">

    <!-- Card with shimmer effect - cover only -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/skeleton_card"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/material_layout_avatar"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="8dp"
        app:layout_constrainedHeight="true"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <!-- Cover placeholder with shimmer effect -->
        <View
            android:id="@+id/skeleton_cover"
            android:layout_width="@dimen/material_layout_avatar"
            android:layout_height="@dimen/material_layout_avatar"
            android:background="@color/skeleton_placeholder" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
