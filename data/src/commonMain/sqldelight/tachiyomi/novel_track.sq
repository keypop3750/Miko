CREATE TABLE novel_track(
    _id INTEGER NOT NULL PRIMARY KEY,
    novel_id INTEGER NOT NULL,
    sync_id INTEGER NOT NULL,
    remote_id INTEGER NOT NULL,
    library_id INTEGER,
    title TEXT NOT NULL,
    last_chapter_read REAL NOT NULL,
    total_chapters INTEGER NOT NULL,
    status INTEGER NOT NULL,
    score REAL NOT NULL,
    remote_url TEXT NOT NULL,
    start_date INTEGER NOT NULL,
    finish_date INTEGER NOT NULL,
    UNIQUE (novel_id, sync_id) ON CONFLICT REPLACE,
    FOREIGN KEY(novel_id) REFERENCES novels(_id) ON DELETE CASCADE
);

CREATE INDEX novel_track_novel_id_index ON novel_track(novel_id);
CREATE INDEX novel_track_sync_id_index ON novel_track(sync_id);

-- Queries

getTracksByNovelId:
SELECT * FROM novel_track
WHERE novel_id = :novelId;

getTrackById:
SELECT * FROM novel_track
WHERE _id = :id;

getTrackByNovelIdAndSyncId:
SELECT * FROM novel_track
WHERE novel_id = :novelId AND sync_id = :syncId;

insertTrack:
INSERT INTO novel_track(
    novel_id,
    sync_id,
    remote_id,
    library_id,
    title,
    last_chapter_read,
    total_chapters,
    status,
    score,
    remote_url,
    start_date,
    finish_date
)
VALUES (
    :novelId,
    :syncId,
    :remoteId,
    :libraryId,
    :title,
    :lastChapterRead,
    :totalChapters,
    :status,
    :score,
    :remoteUrl,
    :startDate,
    :finishDate
);

updateTrack:
UPDATE novel_track
SET
    remote_id = coalesce(:remoteId, remote_id),
    library_id = coalesce(:libraryId, library_id),
    title = coalesce(:title, title),
    last_chapter_read = coalesce(:lastChapterRead, last_chapter_read),
    total_chapters = coalesce(:totalChapters, total_chapters),
    status = coalesce(:status, status),
    score = coalesce(:score, score),
    remote_url = coalesce(:remoteUrl, remote_url),
    start_date = coalesce(:startDate, start_date),
    finish_date = coalesce(:finishDate, finish_date)
WHERE _id = :id;

deleteTrack:
DELETE FROM novel_track
WHERE _id = :id;

deleteTrackByNovelIdAndSyncId:
DELETE FROM novel_track
WHERE novel_id = :novelId AND sync_id = :syncId;

deleteTracksByNovelId:
DELETE FROM novel_track
WHERE novel_id = :novelId;

selectLastInsertedRowId:
SELECT last_insert_rowid();
