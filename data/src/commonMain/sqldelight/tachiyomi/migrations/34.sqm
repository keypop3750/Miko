-- Migration 34: Add manga_metadata_cache table for Swipes metadata enhancement
-- This table stores enhanced metadata from tracking APIs (AniList, MAL, Kitsu)
-- to improve Swipes card quality with accurate chapter counts, genres, authors, etc.

CREATE TABLE manga_metadata_cache (
    manga_url TEXT NOT NULL,
    source_id INTEGER NOT NULL,
    
    -- Metadata provider information
    provider TEXT NOT NULL, -- 'anilist', 'mal', 'kitsu'
    provider_id INTEGER NOT NULL, -- ID in the external service
    matched_title TEXT NOT NULL, -- Title that was matched
    confidence_score REAL NOT NULL, -- 0.0-1.0 matching confidence
    
    -- Priority 1: Chapter count (most critical)
    total_chapters INTEGER,
    
    -- Priority 2: Genres and tags for filtering
    genres TEXT, -- JSON array: ["Action", "Fantasy", "Adventure"]
    tags TEXT, -- JSON array: ["Isekai", "Magic", "Overpowered MC"]
    
    -- Priority 3: Authors, artists, and publication dates
    authors TEXT, -- JSON array: ["Author Name", "Co-Author"]
    artists TEXT, -- JSON array: ["Artist Name"]
    start_date TEXT, -- ISO format: "2020-01-15"
    end_date TEXT, -- ISO format or NULL for ongoing
    
    -- Priority 4: Quality enhancements
    cover_url_hq TEXT, -- High quality cover URL
    average_score REAL, -- 0-100 rating from community
    description TEXT, -- Rich synopsis
    
    -- Priority 5: Publishing status
    publishing_status TEXT, -- 'RELEASING', 'FINISHED', 'CANCELLED', 'HIATUS'
    
    -- Cache management
    is_ongoing INTEGER NOT NULL DEFAULT 1, -- 1 = ongoing, 0 = completed
    cached_at INTEGER NOT NULL, -- Unix timestamp when first cached
    last_refreshed INTEGER NOT NULL, -- Unix timestamp of last refresh
    
    PRIMARY KEY(manga_url, source_id)
);

-- Index for looking up by provider
CREATE INDEX idx_metadata_cache_provider ON manga_metadata_cache(provider, provider_id);

-- Index for cache refresh queries (find stale ongoing manga)
CREATE INDEX idx_metadata_cache_refresh ON manga_metadata_cache(is_ongoing, last_refreshed);
