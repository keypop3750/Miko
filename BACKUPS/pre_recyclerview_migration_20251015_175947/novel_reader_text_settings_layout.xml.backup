<?xml version="1.0" encoding="utf-8"?>
<eu.kanade.tachiyomi.ui.novel.reader.settings.NovelReaderTextSettingsView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/text_settings_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:background="@drawable/bottom_sheet_rounded_background"
    android:forceDarkAllowed="false">

    <LinearLayout
        android:id="@+id/constraint_layout"
        style="@style/BottomSheetDialogTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/material_component_dialogs_padding_around_content_area"
        android:paddingTop="0dp"
        android:paddingEnd="@dimen/material_component_dialogs_padding_around_content_area">

        <com.google.android.material.textview.MaterialTextView
            style="?textAppearanceTitleSmall"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:textColor="?attr/colorSecondary"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/text_settings" />

        <!-- Text Size Slider -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/text_size"
            android:textColor="?attr/colorOnBackground" />

        <com.google.android.material.slider.Slider
            android:id="@+id/text_size_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="12"
            android:valueTo="32"
            android:value="16"
            android:stepSize="1"
            app:labelBehavior="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_size_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="16sp"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp" />

        <!-- Line Height Slider -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/line_height"
            android:textColor="?attr/colorOnBackground" />

        <com.google.android.material.slider.Slider
            android:id="@+id/line_height_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1.0"
            android:valueTo="2.5"
            android:value="1.5"
            android:stepSize="0.1"
            app:labelBehavior="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/line_height_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1.5x"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp" />

        <!-- Paragraph Spacing Slider -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/paragraph_spacing"
            android:textColor="?attr/colorOnBackground" />

        <com.google.android.material.slider.Slider
            android:id="@+id/paragraph_spacing_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="2"
            android:valueTo="32"
            android:value="16"
            android:stepSize="2"
            app:labelBehavior="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/paragraph_spacing_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="16dp"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp" />

        <com.google.android.material.textview.MaterialTextView
            style="?textAppearanceTitleSmall"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:textColor="?attr/colorSecondary"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alignment" />

        <!-- Text Alignment -->
        <eu.kanade.tachiyomi.widget.MaterialSpinnerView
            android:id="@+id/text_alignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:title="@string/text_alignment"
            android:entries="@array/text_alignment_options" />

    </LinearLayout>
</eu.kanade.tachiyomi.ui.novel.reader.settings.NovelReaderTextSettingsView>
